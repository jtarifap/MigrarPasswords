<?xml version="1.0" encoding="utf-8"?>
<configuration>
  <connectionStrings>
    <clear/>
<add name="Users_ConnectionString"
          connectionString="Data Source=SERVER;Initial Catalog=VVTecnics;Persist Security Info=False;User ID=USER;Password=PASSWORD"
          providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <startup>
    <supportedRuntime version="v2.0.50727"/>
  </startup>
</configuration>
